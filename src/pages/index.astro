---
import SeoHead from "$/components/seo-head.astro";
import { getPostHref, sortPostsByDate } from "$/lib/blog";
import { format } from "$/lib/date";
import { projects } from "$/projects";
import { getCollection } from "astro:content";

const posts = sortPostsByDate(await getCollection("blog")).slice(0, 4);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead description="Jacob's personal website. Writing, code, terminal games, and other things." />
  </head>
  <body>
    <div class="container">
      <header>
        <a class="brand" href="/">jafu.py</a>
        <nav aria-label="Main navigation">
          <a href="/writing">Writing</a>
          <a href="https://github.com/jafupy">GitHub</a>
          <a href="mailto:hello@jafupy.com">Email</a>
        </nav>
      </header>

      <main id="main">
        <h1>Hi, I'm Jacob.</h1>
        <p>
          I write code, play guitar, and sometimes put my thoughts on the internet.
          Mostly JavaScript and Rust, but I like making all sorts of things.
        </p>
        <p>I'm Polish, based in southern England. This is my little corner of the web.</p>

        <section aria-labelledby="writing-heading">
          <h2 id="writing-heading">Writing</h2>
          <ul class="posts">
            {posts.map((post) => (
              <li>
                <div class="post-heading">
                  <a href={getPostHref(post)}>{post.data.title}</a>
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>{format(post.data.date)}</time>
                </div>
                <p>{post.data.description.trim()}</p>
              </li>
            ))}
          </ul>
          <p><a href="/writing">All writing →</a></p>
        </section>

        <section aria-labelledby="projects-heading">
          <h2 id="projects-heading">Things I've made</h2>
          <ul>
            {projects.map((project) => (
              <li>
                <a href={project.href}>{project.title}</a> — {project.description}
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="elsewhere-heading">
          <h2 id="elsewhere-heading">Elsewhere</h2>
          <p>
            I'm on <a href="https://github.com/jafupy">GitHub</a> and
            <a href="https://x.com/jafupy"> Twitter</a>.
            You can also <a href="mailto:hello@jafupy.com">email me</a>.
          </p>
        </section>
      </main>

      <footer>© {year} Jacob.</footer>
    </div>
  </body>
</html>

<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: #fafaf8;
    color: #222;
    font: 16px/1.65 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .container { max-width: 740px; padding: 0 24px; margin: auto; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 0; border-bottom: 1px solid #ddd; }
  .brand { color: inherit; font-weight: 750; letter-spacing: -.04em; font-size: 19px; text-decoration: none; }
  nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 14px; }
  nav a { color: inherit; }
  main { padding: 72px 0 90px; }
  h1 { margin: 0 0 20px; font-size: clamp(2.4rem, 7vw, 3.6rem); line-height: 1.1; letter-spacing: -.055em; }
  h2 { margin: 52px 0 14px; font-size: 1.45rem; line-height: 1.3; letter-spacing: -.025em; }
  p { margin: 0 0 15px; }
  ul { margin: 0 0 16px; padding-left: 23px; }
  li { margin: 8px 0; }
  a { color: #246448; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .posts { list-style: none; padding: 0; }
  .posts li { padding: 14px 0; margin: 0; border-bottom: 1px solid #e3e3de; }
  .post-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .post-heading a { font-weight: 650; }
  time { color: #666; font-size: 12px; white-space: nowrap; }
  .posts p { color: #555; font-size: 14px; margin: 3px 0 0; }
  footer { padding: 22px 0 34px; border-top: 1px solid #ddd; color: #666; font-size: 13px; }
  @media (max-width: 480px) {
    header { align-items: flex-start; flex-direction: column; gap: 8px; }
    main { padding-top: 48px; }
    .post-heading { display: block; }
    time { display: block; }
  }
  @media (prefers-color-scheme: dark) {
    body { background: #181a18; color: #e8e9e6; }
    header, footer { border-color: #444; }
    a { color: #a0d4b4; }
    nav a, .brand { color: inherit; }
    .posts li { border-color: #3b3f3b; }
    time, footer { color: #aaa; }
    .posts p { color: #bbb; }
  }
</style>
