---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/brygada-1918";
import "@fontsource-variable/jetbrains-mono";

import SeoHead from "$/components/seo-head.astro";
import { getPostHref, sortPostsByDate } from "$/lib/blog";
import { format } from "$/lib/date";
import { projects } from "$/projects";
import { getCollection } from "astro:content";

const posts = sortPostsByDate(await getCollection("blog")).slice(0, 3);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      description="Jacob's little corner of the internet. Code, writing, terminal games, and whatever else seems interesting."
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jafu.py, home">
          <span class="brand-mark" aria-hidden="true">j.</span>
          <span>jafu.py</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="/writing">Writing</a>
          <a href="https://github.com/jafupy">GitHub <span aria-hidden="true">↗</span></a>
          <a href="mailto:hello@jafupy.com">Contact <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="intro-title">
          <div class="eyebrow">
            <span class="index">00 / HELLO</span>
            <span class="eyebrow-rule" aria-hidden="true"></span>
            <span>A SMALL CORNER OF THE INTERNET</span>
          </div>

          <div class="hero-grid">
            <h1 id="intro-title">
              <span>I'm Jacob.</span>
              <span>I do <em>stuff.</em></span>
            </h1>

            <div class="hero-aside">
              <p>
                I write code, play guitar, and occasionally put my opinions on the internet.
              </p>
              <p>
                Polish, based in southern England. Mostly JavaScript and Rust.
                The rest is a work in progress.
              </p>
              <a class="text-link" href="/writing">
                Read what I've written <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="hero-bottom" aria-hidden="true">
            <span>PERSONAL WEBSITE / NOT A STARTUP</span>
            <span>SCROLL TO EXPLORE ↓</span>
          </div>
        </section>

        <section class="section writing" aria-labelledby="writing-title">
          <div class="section-heading">
            <div class="heading-left">
              <span class="section-number">01</span>
              <h2 id="writing-title">Writing<span class="period">.</span></h2>
            </div>
            <a class="subtle-link" href="/writing">Everything I've written <span aria-hidden="true">↗</span></a>
          </div>

          <div class="writing-list">
            {posts.map((post, index) => (
              <a class="writing-item" href={getPostHref(post)}>
                <span class="item-number">{String(index + 1).padStart(2, "0")}</span>
                <span class="writing-copy">
                  <span class="writing-title">{post.data.title}</span>
                  <span class="writing-description">{post.data.description.trim()}</span>
                </span>
                <time datetime={post.data.date.toISOString().slice(0, 10)}>{format(post.data.date)}</time>
                <span class="item-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="section experiments" aria-labelledby="projects-title">
          <div class="section-heading">
            <div class="heading-left">
              <span class="section-number">02</span>
              <h2 id="projects-title">Small things<span class="period">.</span></h2>
            </div>
            <p class="section-caption">A few things you can actually click.</p>
          </div>

          <div class="projects-grid">
            {projects.map((project, index) => (
              <a class="project" href={project.href}>
                <span class="project-top">
                  <span class="project-index">EXPERIMENT / {String(index + 1).padStart(2, "0")}</span>
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </span>
                <span class="project-title">{project.title}</span>
                <span class="project-description">{project.description}</span>
              </a>
            ))}
          </div>
        </section>

        <section class="section elsewhere" aria-labelledby="elsewhere-title">
          <div class="section-heading">
            <div class="heading-left">
              <span class="section-number">03</span>
              <h2 id="elsewhere-title">Elsewhere<span class="period">.</span></h2>
            </div>
          </div>
          <div class="elsewhere-links">
            <a href="https://github.com/jafupy"><span>GitHub</span><span aria-hidden="true">↗</span></a>
            <a href="https://x.com/jafupy"><span>Twitter / X</span><span aria-hidden="true">↗</span></a>
            <a href="mailto:hello@jafupy.com"><span>Email</span><span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <span>© {year} Jacob.</span>
        <span>Made for people, not algorithms.</span>
        <a href="#main">Back to top ↑</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --paper: #f8f8f5;
    --ink: #1c211d;
    --muted: #60675f;
    --faint: #7b837a;
    --line: #dadfd7;
    --hover: #eeefe9;
    --accent: #4d6854;
    --inverse: #fff;
    --font-sans: "Bricolage Grotesque Variable", sans-serif;
    --font-serif: "Brygada 1918 Variable", Georgia, serif;
    --font-mono: "JetBrains Mono Variable", monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    font-size: 16px;
  }

  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  ::selection { background: var(--accent); color: var(--inverse); }

  .skip-link {
    position: absolute;
    z-index: 10;
    top: -100px;
    left: 16px;
    background: var(--ink);
    color: var(--paper);
    padding: 10px 16px;
  }
  .skip-link:focus { top: 12px; }

  .shell {
    width: min(100% - 80px, 1000px);
    margin-inline: auto;
  }

  .site-header {
    min-height: 96px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.05em;
  }
  .brand-mark {
    width: 35px;
    height: 35px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.09em;
    padding-right: 2px;
  }
  .site-header nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(15px, 3vw, 33px);
    font-size: 13px;
    font-weight: 600;
  }
  .site-header nav a,
  .text-link,
  .subtle-link,
  .site-footer a {
    transition: color .16s ease;
  }
  .site-header nav a:hover,
  .text-link:hover,
  .subtle-link:hover,
  .site-footer a:hover { color: var(--accent); }

  .hero { padding-top: clamp(78px, 11vw, 142px); }
  .eyebrow,
  .hero-bottom,
  .section-number,
  .item-number,
  .project-index {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .06em;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 17px;
    color: var(--faint);
    font-weight: 500;
  }
  .eyebrow .index { color: var(--accent); }
  .eyebrow-rule { width: 35px; height: 1px; background: var(--line); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(220px, .65fr);
    gap: 45px;
    align-items: end;
    padding: 40px 0 106px;
  }
  h1, h2, p { margin: 0; }
  h1 {
    font-size: clamp(3.1rem, 7.4vw, 6.55rem);
    font-weight: 630;
    letter-spacing: -.082em;
    line-height: 1.06;
  }
  h1 span { display: block; white-space: nowrap; }
  h1 em {
    font-family: var(--font-serif);
    font-size: .97em;
    font-weight: 400;
    letter-spacing: -.085em;
  }
  .hero-aside {
    padding-bottom: 4px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }
  .hero-aside p + p { margin-top: 12px; }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-weight: 650;
    font-size: 13px;
    margin-top: 24px;
  }
  .text-link span { transition: transform .16s ease; }
  .text-link:hover span { transform: translate(2px, -2px); }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    border-top: 1px solid var(--ink);
    padding: 15px 0;
    color: var(--faint);
  }

  .section { padding-top: 112px; }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding-bottom: 26px;
  }
  .heading-left { display: flex; align-items: baseline; gap: 24px; }
  .section-number { color: var(--accent); }
  h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 580;
    letter-spacing: -.065em;
    line-height: 1.1;
  }
  .period { color: var(--accent); }
  .subtle-link, .section-caption {
    font-size: 13px;
    color: var(--muted);
  }
  .subtle-link span { margin-left: 6px; }

  .writing-list { border-top: 1px solid var(--ink); }
  .writing-item {
    display: grid;
    grid-template-columns: 35px minmax(0, 1fr) 95px 18px;
    gap: 15px;
    align-items: start;
    padding: 24px 7px;
    border-bottom: 1px solid var(--line);
    transition: background .16s ease, padding .16s ease;
  }
  .writing-item:hover {
    background: var(--hover);
    padding-inline: 15px;
  }
  .item-number { color: var(--faint); margin-top: 7px; }
  .writing-copy { display: flex; flex-direction: column; gap: 7px; }
  .writing-title {
    font-size: 20px;
    font-weight: 630;
    letter-spacing: -.04em;
    line-height: 1.25;
  }
  .writing-description {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    max-width: 65ch;
  }
  .writing-item time {
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
    color: var(--faint);
    padding-top: 7px;
    text-align: right;
  }
  .item-arrow {
    color: var(--faint);
    font-size: 16px;
    padding-top: 3px;
    transition: transform .16s ease, color .16s ease;
  }
  .writing-item:hover .item-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    border-top: 1px solid var(--ink);
    padding-top: 16px;
  }
  .project {
    min-height: 215px;
    padding: 23px;
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    transition: border-color .16s ease, background .16s ease, transform .16s ease;
  }
  .project:hover {
    background: var(--hover);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 10px;
    margin-bottom: auto;
  }
  .project-index { color: var(--faint); }
  .project-arrow { font-size: 17px; line-height: 1; color: var(--accent); }
  .project-title {
    font-size: 24px;
    font-weight: 650;
    letter-spacing: -.055em;
    margin-top: 28px;
    margin-bottom: 6px;
  }
  .project-description {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .elsewhere { padding-bottom: 108px; }
  .elsewhere-links {
    border-top: 1px solid var(--ink);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .elsewhere-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 20px 20px 20px 0;
    font-size: 15px;
    font-weight: 550;
    border-bottom: 1px solid var(--line);
    transition: color .16s ease;
  }
  .elsewhere-links a:not(:nth-child(3n)) { margin-right: 28px; }
  .elsewhere-links a:hover { color: var(--accent); }
  .elsewhere-links a span:last-child { color: var(--faint); }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    padding: 25px 0 40px;
    border-top: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--faint);
  }

  @media (max-width: 760px) {
    .shell { width: min(100% - 44px, 1000px); }
    .site-header { min-height: 80px; }
    .hero-grid {
      display: block;
      padding: 34px 0 78px;
    }
    h1 { font-size: clamp(3.1rem, 10vw, 5.3rem); }
    .hero-aside { max-width: 450px; margin-top: 35px; }
    .section { padding-top: 85px; }
    .projects-grid { gap: 10px; }
    .project { min-height: 195px; padding: 17px; }
    .project-title { font-size: 21px; }
  }

  @media (max-width: 560px) {
    .site-header { align-items: center; }
    .site-header nav { gap: 15px; font-size: 12px; }
    .site-header nav a:nth-child(2) { display: none; }
    .brand { font-size: 16px; }
    .brand-mark { height: 31px; width: 31px; }
    .eyebrow { font-size: 9px; gap: 10px; }
    .eyebrow-rule { width: 16px; }
    h1 { font-size: clamp(2.85rem, 10.2vw, 3.6rem); }
    .hero-bottom span:last-child { display: none; }
    .section-heading { align-items: start; }
    .heading-left { gap: 14px; }
    .section-caption { text-align: right; max-width: 115px; }
    .subtle-link { text-align: right; max-width: 125px; }
    .writing-item { grid-template-columns: 22px minmax(0, 1fr) 17px; gap: 10px; padding: 21px 0; }
    .writing-item time { grid-column: 2; grid-row: 2; text-align: left; padding-top: 0; }
    .writing-item .item-arrow { grid-column: 3; grid-row: 1; }
    .writing-title { font-size: 18px; }
    .projects-grid { grid-template-columns: 1fr; }
    .project { min-height: 160px; }
    .project-title { margin-top: 22px; }
    .elsewhere-links { grid-template-columns: 1fr; }
    .elsewhere-links a:not(:nth-child(3n)) { margin-right: 0; }
    .elsewhere { padding-bottom: 75px; }
    .site-footer { flex-wrap: wrap; gap: 12px; }
    .site-footer span:nth-child(2) { order: 3; width: 100%; }
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #161915;
      --ink: #edf0e9;
      --muted: #afb7ab;
      --faint: #939e90;
      --line: #3a4037;
      --hover: #222820;
      --accent: #b5d6ad;
      --inverse: #121711;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; }
  }
</style>
